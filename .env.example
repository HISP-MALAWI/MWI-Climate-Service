CLIMATE_SERVICE_CONFIG=/path/to/sri-lanka-climate-service/climate-service.yaml
PROJ_DATA=/path/to/.venv/lib/python3.13/site-packages/rasterio/proj_data
ENACTS_API_KEY=your_actual_api_key_here

# Required for ERA5-Land ingestion (DestinE Earth Data Hub credentials)
# EDH_USERNAME=
# EDH_PASSWORD=

# Required for MODIS MCD12Q1 land cover ingestion (Copernicus Data Space Ecosystem)
# Also requires TerraAqua/MODIS collection activation at dataspace.copernicus.eu
# CDSE_USERNAME=
# CDSE_PASSWORD=
